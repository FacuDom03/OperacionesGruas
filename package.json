{
  "name": "central-operativa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:importador",
    "build:importador": "esbuild scripts/importar-excel.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/importar-excel.js --banner:js=\"import{createRequire as __crearRequire}from'node:module';const require=__crearRequire(import.meta.url);\"",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx scripts/probar-formato.ts",
    "import:excel": "tsx scripts/importar-excel.ts",
    "usuario": "tsx scripts/crear-usuario.ts",
    "respaldo": "bash scripts/respaldo.sh",
    "fuentes": "node scripts/bajar-fuentes.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "next": "^15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "puppeteer": "^25.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
