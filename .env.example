# ─── Base de datos ───────────────────────────────────────────────────────────
# Desarrollo local (el Postgres de docker-compose.dev.yml, puerto 5433)
DATABASE_URL=postgresql://central:central@localhost:5433/central_operativa

# En EasyPanel se usa el nombre interno del servicio de Postgres, no localhost.
# Ejemplo: postgresql://central:LA_CLAVE@proyecto_postgres:5432/central_operativa

# ─── Autenticacion ───────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=cambiar-esto
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── n8n / WhatsApp ──────────────────────────────────────────────────────────
# La app NO llama a Meta: le pega a este webhook de n8n y n8n hace el envio.
N8N_WHATSAPP_WEBHOOK_URL=https://n8n.tudominio.com/webhook/salida-whatsapp
N8N_WEBHOOK_TOKEN=cambiar-esto

# Token que n8n manda en el header x-api-key al volcar los checklists
# en POST /api/checklists y al actualizar estados en /api/envios/[wamid]
CHECKLIST_API_KEY=cambiar-esto

# Plantilla aprobada por Meta para iniciar la conversacion
WHATSAPP_TEMPLATE=salida_trabajo_v1

# ─── Archivos y zona horaria ─────────────────────────────────────────────────
PDF_STORAGE_PATH=/app/storage/pdf
TZ=America/Argentina/Buenos_Aires

# ─── Puppeteer ───────────────────────────────────────────────────────────────
# En Docker ya viene seteado. Localmente, dejalo vacio para que use el Chrome
# que descarga npm, o apunta a tu navegador:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=
